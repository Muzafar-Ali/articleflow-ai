{
  "name": "articleflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Stateful AI content publishing agent built with LangGraph, Node.js, TypeScript, PostgreSQL, Redis/BullMQ, OpenAI and Notion.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:db": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.database.config.cjs --runInBand",
    "test:db:local": "node --env-file=.env.test --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.database.config.cjs --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node --env-file=.env --import=tsx src/database/check-connection.ts",
    "db:check:compiled": "node dist/database/check-connection.js",
    "dev:api": "node --env-file=.env --watch --import=tsx src/api/server.ts",
    "dev:worker": "node --env-file=.env --watch --import=tsx src/worker/index.ts",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/index.js"
  },
  "keywords": [],
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
